APP_ENVIRONMENT=production
FRONTEND_ORIGIN=https://wedding.example.com

S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=replace-with-restricted-access-key
S3_SECRET_ACCESS_KEY=replace-with-restricted-secret-key
S3_BUCKET=replace-with-private-bucket-name
S3_REGION=fsn1
S3_ADDRESSING_STYLE=virtual

# Generate these with: python tools/hash_password.py
WEDDING_GUEST_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace$replace
WEDDING_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace$replace
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-at-least-32-random-characters

SESSION_TTL_SECONDS=86400
COOKIE_SECURE=true
# Use "none" for genuinely cross-site frontend/API origins; "lax" is preferable
# when both hosts share the same registrable domain.
COOKIE_SAMESITE=none

SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_SIZE=26214400
MAX_IMAGE_PIXELS=50000000
THUMBNAIL_MAX_DIMENSION=1280
GALLERY_PAGE_SIZE=50
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=900
RETENTION_UNTIL=2027-03-31
